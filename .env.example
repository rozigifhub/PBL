# Salin nilai-nilai ini ke file .env (file .env TIDAK di-commit!)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=merchandise
DB_USER=postgres
DB_PASSWORD=

# URL aplikasi untuk link di email reset.
# Kosongkan = otomatis dari host request.
APP_URL=

# SMTP Brevo — ambil kredensial di dashboard Brevo > SMTP & API
# Kosongkan SMTP_USER untuk mode pengembangan
# (tautan reset dicatat ke mail_log.txt, tidak ada email terkirim)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
