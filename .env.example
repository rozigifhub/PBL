# Salin nilai-nilai ini ke file .env (file .env TIDAK di-commit!)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=merchandise
DB_USER=postgres
DB_PASSWORD=

# URL aplikasi untuk link di email reset.
# Kosongkan = otomatis dari host request.
APP_URL=

# Email dikirim via Brevo API (HTTPS). Yang dibutuhkan hanya API key.
# Kosongkan SMTP_PASS untuk mode pengembangan
# (tautan reset dicatat ke mail_log.txt, tidak ada email terkirim)
SMTP_PASS=
MAIL_FROM=

# Midtrans (pembayaran) — ambil di dashboard Midtrans > Settings > Access Keys
# Sandbox diawali "SB-Mid-server-..." / "SB-Mid-client-..."
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
